<mxfile host="drawio"><diagram id="workload-identity" name="workload-identity"><mxGraphModel dx="1400" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Workload Identity: pod in &amp;lt;gke-project&amp;gt; reads a secret in &amp;lt;dev-project&amp;gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="gkeproj" value="GCP project &amp;lt;gke-project&amp;gt; (number &amp;lt;gke-project-number&amp;gt;)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#9AA0A6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="660" height="400" as="geometry"/></mxCell><mxCell id="cluster" value="GKE Autopilot cluster" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF3FD;strokeColor=#326CE5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#326CE5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="400" height="340" as="geometry"/></mxCell><mxCell id="ns-dev" value="namespace dev" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=2;fontColor=#326CE5;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="360" height="130" as="geometry"/></mxCell><mxCell id="pod" value="&lt;b&gt;Pod&lt;/b&gt; tome-ms-language&lt;br&gt;serviceAccountName: tome-ms-language&lt;br&gt;(totoms SDK, Application Default Credentials)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1A4FB4;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="175" width="320" height="70" as="geometry"/></mxCell><mxCell id="mds" value="&lt;b&gt;GKE metadata server&lt;/b&gt;&lt;br&gt;(on every node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="320" height="60" as="geometry"/></mxCell><mxCell id="pool" value="&lt;b&gt;Workload Identity pool&lt;/b&gt;&lt;br&gt;&amp;lt;gke-project&amp;gt;.svc.id.goog&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;one per project, shared by all its clusters;&lt;br&gt;trusts tokens signed by them&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="190" height="100" as="geometry"/></mxCell><mxCell id="sts" value="&lt;b&gt;Security Token Service&lt;/b&gt;&lt;br&gt;sts.googleapis.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="320" width="190" height="70" as="geometry"/></mxCell><mxCell id="p-dev" value="GCP project &amp;lt;dev-project&amp;gt; (managed by toto-terra)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="600" height="400" as="geometry"/></mxCell><mxCell id="iam" value="&lt;b&gt;IAM binding&lt;/b&gt; (toto-terra, tome-ms-language.tf)&lt;br&gt;role roles/secretmanager.secretAccessor&lt;br&gt;member principal://iam.googleapis.com/projects/&amp;lt;gke-project-number&amp;gt;/&lt;br&gt;locations/global/workloadIdentityPools/&amp;lt;gke-project&amp;gt;.svc.id.goog/&lt;br&gt;subject/ns/&lt;b&gt;dev&lt;/b&gt;/sa/&lt;b&gt;tome-ms-language&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="560" height="110" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;projects/&amp;lt;dev-project&amp;gt;/secrets/mongo-host, jwt-signing-key, ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="320" width="560" height="70" as="geometry"/></mxCell><mxCell id="e1" value="1. get credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1A73E8;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pod" target="mds"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="2. exchange the pod's&lt;br&gt;Kubernetes token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1A73E8;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mds" target="sts"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pool" value="validates against" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#5F6368;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sts" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="3. short-lived Google access token&lt;br&gt;for principal ns/dev/sa/tome-ms-language" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#34A853;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sts" target="pod"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="565" y="290"/><mxPoint x="240" y="290"/></Array></mxGeometry></mxCell><mxCell id="e4" value="4. access secret (Bearer token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1A73E8;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="pod" target="sm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="160"/><mxPoint x="720" y="160"/><mxPoint x="720" y="355"/></Array></mxGeometry></mxCell><mxCell id="e5" value="5. checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#34A853;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sm" target="iam"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;prod&lt;/b&gt; works the same way: namespace prod &amp;rarr; project &amp;lt;prod-project&amp;gt;, granted by the toto-terra apply on &amp;lt;prod-project&amp;gt;.&lt;br&gt;No Google service account and no key: the principal is the Kubernetes service account itself. Namespace + KSA name &lt;i&gt;is&lt;/i&gt; the identity, in every cluster of &amp;lt;gke-project&amp;gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#B0A060;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1340" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
