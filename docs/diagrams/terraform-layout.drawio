<mxfile host="drawio"><diagram id="terraform-layout" name="terraform-layout"><mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Terraform layout: who creates what, and in which order" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="vm" value="&lt;b&gt;Terraform VM&lt;/b&gt; (terra)&lt;br&gt;ADC from the VM service account&lt;br&gt;source scripts/tf-env.*.sh (TF_VAR_*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="230" height="70" as="geometry"/></mxCell><mxCell id="bucket" value="&lt;b&gt;GCS bucket toto-terra-gke-dr&lt;/b&gt;&lt;br&gt;terraform/cluster&lt;br&gt;terraform/state" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="repo" value="Repo toto-terra-gke" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="620" height="480" as="geometry"/></mxCell><mxCell id="cluster" value="&lt;b&gt;1. cluster/&lt;/b&gt; &amp;nbsp;(state terraform/cluster)&lt;br&gt;APIs, VPC, subnet, Cloud NAT, node SA,&lt;br&gt;GKE Autopilot cluster, Gateway static IP,&lt;br&gt;Cloud DNS zone dr.&amp;lt;domain&amp;gt;, Certificate Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="280" height="110" as="geometry"/></mxCell><mxCell id="outputs" value="&lt;b&gt;outputs&lt;/b&gt;&lt;br&gt;gke_project_number, gke_workload_pool,&lt;br&gt;gke_nat_ip, domain_name_servers,&lt;br&gt;gateway_ip_name, gateway_certmap_name,&lt;br&gt;env_hostnames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="260" height="110" as="geometry"/></mxCell><mxCell id="workloads" value="&lt;b&gt;4. workloads/&lt;/b&gt; &amp;nbsp;(state terraform/state)&lt;br&gt;namespaces dev, prod, gateway&lt;br&gt;Gateway public-gateway + http-to-https&lt;br&gt;per service and environment: KSA, ConfigMap,&lt;br&gt;Deployment, Service, HTTPRoute, HealthCheckPolicy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="580" height="110" as="geometry"/></mxCell><mxCell id="k8s" value="Kubernetes API of the cluster&lt;br&gt;(kubernetes provider, token of the VM identity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#326CE5;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="580" height="50" as="geometry"/></mxCell><mxCell id="registrar" value="&lt;b&gt;2. Registrar (manual)&lt;/b&gt;&lt;br&gt;4 NS records &lt;i&gt;dr&lt;/i&gt; &amp;rarr; domain_name_servers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="380" height="60" as="geometry"/></mxCell><mxCell id="tototerra" value="Repo toto-terra (applied once per environment)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="420" height="340" as="geometry"/></mxCell><mxCell id="tt" value="&lt;b&gt;3. tome-ms-language.tf&lt;/b&gt;&lt;br&gt;inputs gke_project_id, gke_project_number&lt;br&gt;secretAccessor &amp;rarr; principal ns/&amp;lt;env&amp;gt;/sa/tome-ms-language&lt;br&gt;Artifact Registry (public read), secrets, ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9334E6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="240" width="380" height="100" as="geometry"/></mxCell><mxCell id="tt-dev" value="gcp_pid = &amp;lt;dev-project&amp;gt;&lt;br&gt;toto_environment = dev" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="380" width="180" height="60" as="geometry"/></mxCell><mxCell id="tt-prod" value="gcp_pid = &amp;lt;prod-project&amp;gt;&lt;br&gt;toto_environment = prod" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="380" width="180" height="60" as="geometry"/></mxCell><mxCell id="manual" value="&lt;b&gt;Manual, outside Terraform (once)&lt;/b&gt;&lt;br&gt;&amp;bull; create bucket toto-terra-gke-dr&lt;br&gt;&amp;bull; VM: scope cloud-platform, service account with rights on the bucket and the project&lt;br&gt;&amp;bull; gke-nodes: roles/container.defaultNodeServiceAccount&lt;br&gt;&amp;bull; VM service account: serviceAccountUser on gke-nodes" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#B0A060;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="600" height="110" as="geometry"/></mxCell><mxCell id="e-vm-bucket" value="state + lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#5F6368;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vm" target="bucket"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-c-out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9334E6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cluster" target="outputs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-out-wl" value="terraform_remote_state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9334E6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="outputs" target="workloads"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-wl-k8s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9334E6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="workloads" target="k8s"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-out-reg" value="domain_name_servers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#5F6368;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="outputs" target="registrar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-out-tt" value="gke_project_number" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#5F6368;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="outputs" target="tt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="180"/><mxPoint x="940" y="290"/></Array></mxGeometry></mxCell><mxCell id="e-tt-dev" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#5F6368;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tt" target="tt-dev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-tt-prod" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;dashed=1;strokeColor=#5F6368;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tt" target="tt-prod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-vm-cluster" value="apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9334E6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vm" target="cluster"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
